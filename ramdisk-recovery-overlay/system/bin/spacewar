#!/system/bin/sh

# Mount and required partitions first
mount /data
mount /mnt/system

# Create bind mounts for chroot
mount --bind /dev /mnt/system/dev
mount --bind /proc /mnt/system/proc
mount --bind /sys /mnt/system/sys
mount --bind /dev/pts /mnt/system/dev/pts
mount --bind /data /mnt/system/userdata

# Enter chroot and log it
chroot /mnt/system /bin/bash -x << 'EOF'
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Remount rootfs RW
mount -o remount,rw /

# Install the otafixer script first
cp /userdata/patch/usr/bin/otafixer /usr/bin/
chmod +x /usr/bin/otafixer

# Run the otafixer
otafixer

EOF

# Now that chroot has exited, we can unmount
umount /mnt/system/dev/pts
umount /mnt/system/dev
umount /mnt/system/proc
umount /mnt/system/sys
umount /mnt/system/userdata
umount /mnt/system

# Flash the kernel
dd if=/data/patch/boot.img of=/dev/block/by-name/boot_b
dd if=/data/patch/vendor_boot.img of=/dev/block/by-name/vendor_boot_b

# Final cleanup
umount /data
reboot
