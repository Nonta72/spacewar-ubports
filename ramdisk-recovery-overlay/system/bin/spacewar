#!/system/bin/sh

#Mount
mount /data
mkdir -p /mnt/ut
mount /data/ubuntu.img /mnt/ut

#Setup Directories
mkdir -p /mnt/ut/usr/share/halium-overlay/vendor/etc/audio/
mkdir -p /mnt/ut/usr/share/halium-overlay/vendor/lib/hw/
mkdir -p /mnt/ut/usr/share/halium-overlay/vendor/lib/soundfx/
mkdir -p /mnt/ut/usr/share/halium-overlay/vendor/lib64/soundfx/
mkdir -p /mnt/ut/etc/systemd/system/lightdm.service.d
mkdir -p /mnt/ut/etc/systemd/system/repowerd.service.d
mkdir -p /mnt/ut/etc/systemd/system/sockets.target.wants
mkdir -p /mnt/ut/etc/systemd/system/ssh.service.requires

#Copy kernel modules
rm -rf /mnt/ut/usr/lib/modules/5.4.*
cp -R /data/patch/usr/lib/modules/5.4.289-qgki-gcfce8884187a /mnt/ut/usr/lib/modules/
depmod -a

#Install overlay files
cp -f /data/patch/etc/apparmor.d/tunables/alias.d/rootfs-overlay /mnt/ut/etc/apparmor.d/tunables/alias.d/rootfs-overlay
cp -f /data/patch/etc/default/usb-moded.d/device-specific-config.conf /mnt/ut/etc/default/usb-moded.d/device-specific-config.conf
cp -f /data/patch/etc/deviceinfo/devices/halium.yaml /mnt/ut/etc/deviceinfo/devices/halium.yaml
cp -f /data/patch/etc/ofono/ril_subscription.conf /mnt/ut/etc/ofono/ril_subscription.conf
cp -f /data/patch/etc/ofono/binder.d/qti.conf /mnt/ut/etc/ofono/binder.d/qti.conf
cp -f /data/patch/etc/sysctl.d/98-Spacewar.conf /mnt/ut/etc/sysctl.d/98-Spacewar.conf
cp -f /data/patch/usr/lib/systemd/system/umtprd.service /mnt/ut/usr/lib/systemd/system/umtprd.service
cp -f /data/patch/etc/systemd/system/lightdm.service.d/override.conf /mnt/ut/etc/systemd/system/lightdm.service.d/override.conf
cp -f /data/patch/etc/systemd/system/repowerd.service.d/override.conf /mnt/ut/etc/systemd/system/repowerd.service.d/override.conf
cp -f /data/patch/etc/umtprd/umtprd.conf /mnt/ut/etc/umtprd/umtprd.conf
cp -f /data/patch/etc/usb-moded/90-device-specific-config.ini /mnt/ut/etc/usb-moded/90-device-specific-config.ini
cp -f /data/patch/etc/usb-moded/dyn-modes/mtp.ini.in /mnt/ut/etc/usb-moded/dyn-modes/mtp.ini.in
cp -f /data/patch/etc/usb-moded/dyn-modes/mtp_adb.ini.in /mnt/ut/etc/usb-moded/dyn-modes/mtp_adb.ini.in
cp -f /data/patch/etc/usb-moded/run/mtp-umtprd.ini /mnt/ut/etc/usb-moded/run/mtp-umtprd.ini
cp -f /data/patch/etc/usb-moded/run/mtp-umtprd.ini /mnt/ut/etc/usb-moded/run/mtp-umtprd.ini
cp -f /data/patch/etc/fscrypt.conf /mnt/ut/etc/fscrypt.conf
cp -f /data/patch/etc/gbinder.conf /mnt/ut/etc/gbinder.conf
cp -f /data/patch/usr/bin/umtprd /mnt/ut/usr/bin/umtprd
cp -f /data/patch/usr/bin/usb-tethering /mnt/ut/usr/bin/usb-tethering
cp -f /data/patch/usr/lib/modules-load.d/Spacewar.conf /mnt/ut/usr/lib/modules-load.d/Spacewar.conf
cp -f /data/patch/usr/lib/systemd/system/hfd-service.service.d/wait-for-service.conf /mnt/ut/usr/lib/systemd/system/hfd-service.service.d/wait-for-service.conf
cp -f /data/patch/usr/lib/udev/rules.d/70-Spacewar.rules /mnt/ut/usr/lib/udev/rules.d/70-Spacewar.rules
cp -f /data/patch/usr/libexec/lxc-android-config/device-hacks /mnt/ut/usr/libexec/lxc-android-config/device-hacks
cp -f /data/patch/usr/libexec/usb-moded/umtprd-functionfs.sh /mnt/ut/usr/libexec/usb-moded/umtprd-functionfs.sh
cp -f /data/patch/usr/libexec/hfd-service /mnt/ut/usr/libexec/hfd-service
cp -f /data/patch/usr/libexec/umtprd-manager /mnt/ut/usr/libexec/umtprd-manager
cp -f /data/patch/usr/share/repowerd/device-configs/config-default.xml /mnt/ut/usr/share/repowerd/device-configs/config-default.xml
cp -f /data/patch/usr/share/halium-overlay/odm/ueventd.rc /mnt/ut/usr/share/halium-overlay/odm/ueventd.rc
#cp -f /data/patch/usr/share/halium-overlay/vendor/etc/init/vndservicemanager.rc /usr/share/halium-overlay/vendor/bin/vndservicemanager
cp -f /data/patch/usr/share/halium-overlay/system/etc/prop.halium /mnt/ut/usr/share/halium-overlay/system/etc/prop.halium
cp -f /data/patch/usr/share/halium-overlay/vendor/etc/init/android.hardware.biometrics.fingerprint@2.1-service.rc /mnt/ut/usr/share/halium-overlay/vendor/etc/init/android.hardware.biometrics.fingerprint@2.1-service.rc
cp -f /data/patch/usr/share/halium-overlay/vendor/etc/init/hw/init.qcom.usb.rc /mnt/ut/usr/share/halium-overlay/vendor/etc/init/hw/init.qcom.usb.rc
cp -f /data/patch/usr/share/halium-overlay/vendor/etc/perf/commonresourceconfigs.xml /mnt/ut/usr/share/halium-overlay/vendor/etc/perf/commonresourceconfigs.xml

#Fix permissions
chmod 664 /mnt/ut/usr/share/halium-overlay/vendor/etc/perf/commonresourceconfigs.xml
chmod 664 /mnt/ut/usr/share/halium-overlay/vendor/etc/init/hw/init.qcom.usb.rc
chmod 664 /mnt/ut/usr/share/halium-overlay/vendor/etc/init/android.hardware.biometrics.fingerprint@2.1-service.rc
chmod 664 /mnt/ut/usr/share/halium-overlay/system/etc/prop.halium
chmod 755 /mnt/ut/usr/share/halium-overlay/vendor/bin/vndservicemanager
chmod 664 /mnt/ut/usr/share/halium-overlay/odm/ueventd.rc
chmod 664 /mnt/ut/usr/share/repowerd/device-configs/config-default.xml
chmod 755 /mnt/ut/usr/libexec/umtprd-manager
chmod 755 /mnt/ut/usr/libexec/hfd-service
chmod 755 /mnt/ut/usr/libexec/usb-moded/umtprd-functionfs.sh
chmod 755 /mnt/ut/usr/libexec/lxc-android-config/device-hacks
chmod 664 /mnt/ut/usr/lib/udev/rules.d/70-Spacewar.rules
chmod 664 /mnt/ut/usr/lib/systemd/system/hfd-service.service.d/wait-for-service.conf
chmod 664 /mnt/ut/usr/lib/modules-load.d/Spacewar.conf
chmod 755 /mnt/ut/usr/bin/usb-tethering
chmod 755 /mnt/ut/usr/bin/umtprd
chmod 664 /mnt/ut/etc/gbinder.conf
chmod 664 /mnt/ut/etc/fscrypt.conf
chmod 664 /mnt/ut/etc/usb-moded/run/mtp-umtprd.ini
chmod 664 /mnt/ut/etc/usb-moded/run/mtp-umtprd.ini
chmod 664 /mnt/ut/etc/usb-moded/dyn-modes/mtp_adb.ini.in
chmod 664 /mnt/ut/etc/usb-moded/dyn-modes/mtp.ini.in
chmod 664 /mnt/ut/etc/usb-moded/90-device-specific-config.ini
chmod 664 /mnt/ut/etc/umtprd/umtprd.conf
chmod 644 /mnt/ut/usr/lib/systemd/system/umtprd.service
chmod 664 /mnt/ut/etc/ofono/binder.d/qti.conf
chmod 664 /mnt/ut/etc/ofono/ril_subscription.conf
chmod 664 /mnt/ut/etc/deviceinfo/devices/halium.yaml
chmod 664 /mnt/ut/etc/default/usb-moded.d/device-specific-config.conf
chmod 664 /mnt/ut/etc/apparmor.d/tunables/alias.d/rootfs-overlay
chmod 644 /mnt/ut/etc/systemd/system/lightdm.service.d/override.conf
chmod 644 /mnt/ut/etc/systemd/system/repowerd.service.d/override.conf

#Create appropriate symlinks
#rm /etc/systemd/user/graphical-session.target.wants/umtprd-manager.service
ln -sf /vendor/etc/audio/sku_lahaina_qssi/audio_policy_configuration.xml /mnt/ut/usr/share/halium-overlay/vendor/etc/audio/audio_policy_configuration.xml
ln -sf /vendor/etc/audio/sku_lahaina/audio_effects.xml /mnt/ut/usr/share/halium-overlay/vendor/etc/audio_effects.xml
ln -sf /vendor/etc/audio/sku_lahaina/audio_io_policy.conf /mnt/ut/usr/share/halium-overlay/vendor/etc/audio_io_policy.conf
ln -sf /vendor/etc/audio/sku_lahaina/audio_platform_info_intcodec.xml /mnt/ut/usr/share/halium-overlay/vendor/etc/audio_platform_info_intcodec.xml
ln -sf /vendor/etc/audio/sku_lahaina_qssi/audio_policy_configuration.xml /mnt/ut/usr/share/halium-overlay/vendor/etc/audio_policy_configuration.xml
ln -sf /vendor/etc/audio/sku_lahaina/audio_tuning_mixer.txt /mnt/ut/usr/share/halium-overlay/vendor/etc/audio_tuning_mixer.txt
ln -sf /vendor/etc/audio/sku_lahaina/mixer_paths.xml /mnt/ut/usr/share/halium-overlay/vendor/etc/mixer_paths.xml
ln -sf /vendor/etc/audio/sku_lahaina/sound_trigger_mixer_paths.xml /mnt/ut/usr/share/halium-overlay/vendor/etc/sound_trigger_mixer_paths.xml
ln -sf /vendor/etc/audio/sku_lahaina/sound_trigger_platform_info.xml /mnt/ut/usr/share/halium-overlay/vendor/etc/sound_trigger_platform_info.xml
ln -sf /android/vendor/lib64/hw/sound_trigger.primary.lahaina.so /mnt/ut/usr/share/halium-overlay/vendor/lib/hw/sound_trigger.primary.lahaina.so
ln -sf /android/vendor/lib64/soundfx/libqcompostprocbundle.so /mnt/ut/usr/share/halium-overlay/vendor/lib/soundfx/libqcompostprocbundle.so
ln -sf /android/vendor/lib64/soundfx/libqcomvisualizer.so /mnt/ut/usr/share/halium-overlay/vendor/lib/soundfx/libqcomvisualizer.so
ln -sf /android/vendor/lib/libadm.so /mnt/ut/usr/share/halium-overlay/vendor/lib/libadm.so
ln -sf /android/vendor/lib64/libqtigef.so /mnt/ut/usr/share/halium-overlay/vendor/lib/libqtigef.so
ln -sf /android/vendor/lib64/hw/sound_trigger.primary.lahaina.so /mnt/ut/usr/share/halium-overlay/vendor/lib64/sound_trigger.primary.lahaina.so
ln -sf /dev/null /mnt/ut/usr/share/halium-overlay/vendor/lib64/hw/gralloc.common.so
ln -sf /dev/null /mnt/ut/usr/share/halium-overlay/vendor/lib64/hw/gralloc.default.so
ln -sf /android/vendor/lib64/libqcompostprocbundle.so /mnt/ut/usr/share/halium-overlay/vendor/lib64/soundfx/libqcompostprocbundle.so
ln -sf /usr/lib/systemd/user/umtprd-manager.service /mnt/ut/etc/systemd/user/graphical-session.target.wants/umtprd-manager.service
ln -sf /dev/null /mnt/ut/etc/systemd/system/serial-getty@hvc0.service
ln -sf /dev/null /mnt/ut/etc/systemd/user/mtp-server-usb-moded-watcher.service
ln -sf /usr/lib/systemd/system/ssh.socket /mnt/ut/etc/systemd/system/sockets.target.wants/ssh.socket
ln -sf /usr/lib/systemd/system/ssh.socket /mnt/ut/etc/systemd/system/ssh.service.requires/ssh.socket

# Flash the kernel
dd if=/data/patch/boot.img of=/dev/block/by-name/boot_b
dd if=/data/patch/vendor_boot.img of=/dev/block/by-name/vendor_boot_b

# Cleanup
#rm /mnt/ut/usr/lib/udev/rules.d/70-fp5.rules

# Unmount now
umount /mnt/ut
umount /data
